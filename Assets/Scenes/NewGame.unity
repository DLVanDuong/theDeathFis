--- !u!114 &20326311
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 20326307}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc391846c9a28904eb8a8582279432d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  director: {fileID: 20326309}
  ui: {fileID: 0}
  lines:
  - text: "V\u01B0\u01A1ng qu\u1ED1c \u0111\xE3 ch\xECm trong l\u1EDDi nguy\u1EC1n."
    atTime: 0.5
    hold: 2.2
  - text: "Ng\u01B0\u01A1i l\xE0 k\u1EBB cu\u1ED1i c\xF9ng c\xF2n c\u1EA7m ki\u1EBFm."
    atTime: 3.2
    hold: 2.2
  - text: "B\u1ED1n con r\u1ED3ng gi\u1EEF Nh\u1EEFng Thanh Ki\u1EBFm \u2014 H\u1ECFa,
      B\u0103ng, L\xF4i, \u0110i\u1EC7n."
    atTime: 6
    hold: 2.2
  - text: "Ng\u01B0\u1EDDi s\u1EBD ph\u1EA3i ch\u1EB7c \u0111\u1EE9t t\u1EEBng m\u1EAFt
      X\xEDch! thu th\u1EADp \u0111\u1EE7 4 Thanh Ki\u1EBFm."
    atTime: 9
    hold: 2.2
  - text: "N\u1EBFu ng\u01B0\u01A1i ng\xE3 xu\u1ED1ng, \xE1nh s\xE1ng s\u1EBD t\u1EAFt."
    atTime: 11.5
    hold: 2.2
  - text: "V\u1EADy ta kh\xF4ng ng\xE3. \u0110\xEAm nay, h\xE0nh tr\xECnh b\u1EAFt
      \u0111\u1EA7u."
    atTime: 13
    hold: 2.2
  - text: "Nh\u1EA5n Space \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u h\xE0nh tr\xECnh.
      (Nh\u1EA5n H \u0111\u1EC3 xem h\u01B0\u1EDBng d\u1EABn )"
    atTime: 14
    hold: 2.2
  activateOnStart:
